<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Harmony" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorSecondary">@color/spotify_black_dark</item>
        <item name="colorSecondaryVariant">@color/spotify_black_light</item>

        <!-- Sunset gradient & pill attributes -->
        <item name="harmonyScreenBackground">@drawable/bg_sunset_gradient</item>
        <item name="harmonyMiniPlayerBackground">@drawable/bg_mini_player_pill</item>
        <item name="harmonySearchBackground">@drawable/bg_search_pill</item>
        <item name="harmonyControlBackground">@drawable/bg_control_pill</item>
        <item name="harmonyTextPrimary">#F8778B</item>
        <item name="harmonyTextSecondary">#F8778B</item>
        <item name="harmonyHintText">#F8778B</item>
        <item name="harmonyMiniControlTint">@drawable/bg_control_pill</item>
    </style>

    <style name="Theme.Harmony" parent="Base.Theme.Harmony" />
</resources>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/libraryMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/harmonyScreenBackground">

    <TextView
        android:id="@+id/libraryHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/your_library"
        android:textColor="?attr/harmonyTextPrimary"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/mostListenedButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/mostListenedButton"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_control_pill"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        android:text="@string/most_listened"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="@id/libraryHeader"
        app:layout_constraintEnd_toStartOf="@id/wrapUpButton"
        app:layout_constraintTop_toTopOf="@id/libraryHeader" />

    <Button
        android:id="@+id/wrapUpButton"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_control_pill"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        android:text="@string/wrap_up"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="@id/libraryHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/libraryHeader" />


    <EditText
        android:id="@+id/searchInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="?attr/harmonySearchBackground"
        android:hint="@string/search_songs_or_artists"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:textColor="?attr/harmonyTextPrimary"
        android:textColorHint="?attr/harmonyHintText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/libraryHeader"
        android:importantForAutofill="no"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/songsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/miniPlayerBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchInput" />

    <LinearLayout
        android:id="@+id/miniPlayerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="?attr/harmonyMiniPlayerBackground"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/miniSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nothing_playing"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniSongArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tap_a_song"
                android:textColor="#D6CEE8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/shuffleButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:alpha="0.5"
            android:background="@drawable/bg_control_pill"
            android:contentDescription="@string/shuffle"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shuffle"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/prevButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_control_pill"
            android:contentDescription="@string/prev"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/playPauseButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_control_pill"
            android:contentDescription="@string/play"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_control_pill"
            android:contentDescription="@string/next"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/repeatButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:alpha="0.5"
            android:background="@drawable/bg_control_pill"
            android:contentDescription="@string/repeat"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_repeat"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/queueButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_control_pill"
            android:contentDescription="@string/queue"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_queue"
            app:tint="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>